# Rust specific ignores
/rust/**/target/
/rust/**/*.rs.bk
/rust/**/Cargo.lock
/rust/**/debug/
/rust/**/release/

# Python specific ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
/python/**/venv/
/python/**/ENV/
/python/**/.env/
/python/**/.venv/

# Node.js ignores
node_modules/
/frontend/.next/
/frontend/out/
npm-debug.log*

# Common data/binary files
*.bin
*.dat
*.db
*.sqlite
*.zip
*.tar.gz

# Log files
*.log
logs/

# IDE files
.vscode/
.idea/
*.swp
