# Rust specific ignores
/rust/**/target/
/rust/**/*.rs.bk
/rust/**/Cargo.lock
/rust/**/debug/
/rust/**/release/

# Python specific ignores
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.poetry.lock
*.cache
*.pytest_cache
*.coverage
cache
*.lock

# Virtual environments
/python/**/venv/
/python/**/ENV/
/python/**/.env/
/python/**/.venv/
/python/**/dist/
/python/**/.poetry.lock/

# Cache python files
/cache/**/

# Node.js ignores
node_modules/
/frontend/.next/
/frontend/out/
/app/node_modules/
/app/.next/
/app/out/
npm-debug.log*

# Common data/binary files
*.bin
*.dat
*.db
*.sqlite
*.zip
*.tar.gz


# Log files
*.log
logs/

# IDE files
.vscode/
.idea/
*.swp
